<mujoco model="rigid_cable_demo">
  <option timestep="0.002" />

  <default>
    <geom contype="0" conaffinity="0" group="0" />
    <default class="conty">
      <geom contype="1" conaffinity="0" condim="6" group="1"
            friction="10 10 10" solref="0.004 1" solimp="9.88 8 0.001"/>
    </default>
    <default class="conaff">
      <geom contype="0" conaffinity="1" condim="6" group="1"
            friction="0.4 0.002 0.00008" solref="0.004 1" />
    </default>
  </default>

  <worldbody>
    <!-- Anchors: bodies only (no geoms), so nothing visible -->
    <!-- <body name="anchor1" pos="0.5 -0.4 0.02"/>
    <body name="anchor2" pos="0.5  0.4 0.02"/> -->

    <!-- Cable along +Y from anchor1 to anchor2 -->
    <composite type="cable" count="26 1 1"
               curve="0 s 0"
               offset="0.5 -0.4 0.02"
               initial="free">
      <joint kind="main" damping="0.01" armature="0.001"/>
      <!-- same thickness (radius = 0.003), length ~0.8m => half-length ~0.0154 -->
      <geom type="capsule" size=".006 .0154" rgba="0.8 0.6 0.4 1" mass="0.001"/>
    </composite>
  </worldbody>


</mujoco>
